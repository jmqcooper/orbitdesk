# Orbitdesk environment contract
#
# Committed, and never holds a secret. It names every variable, where it runs,
# whether it is secret and when it is required. Values live in the store for
# that place:
#
#   development  process env, then .env.local, then .env, then Infisical
#   ci           the job's own env
#   deployed     Railway service variables
#
# Runtime tags pick what each process validates:
#
#   #web     the Next.js app
#   #worker  the pg-boss worker
#   #db      pnpm db:migrate and pnpm db:seed
#
# Profiles select what must be present:
#
#   deployed     a production start script, or any process on Railway
#   ci           next build, a CI job or any other production run: types are
#                checked, nothing is required, no local secret store is touched
#   development  everything else, including pnpm dev
#
# Run `pnpm exec varlock load --agent` to see what resolved with secrets
# redacted. docs/SECRETS.md covers the shared store and a new machine.
#
# @currentEnv=$ORBITDESK_ENV_PROFILE
# @defaultRequired=false
# @defaultSensitive=inferFromPrefix(NEXT_PUBLIC_)
# @defaultDynamic=true
# @import(./.env.infisical, enabled=and(forEnv(development), not(eq($ORBITDESK_SHARED_SECRETS, off))), allowMissing=true)
# ---

# @sensitive=false
RAILWAY_ENVIRONMENT=

# @sensitive=false
CI=

# @tag(web, worker, db) @sensitive=false
NODE_ENV=

# The build and start scripts set this outright, so a build never needs a
# runtime value and a start always does.
# @sensitive=false @internal @type=enum(development, ci, deployed)
ORBITDESK_ENV_PROFILE=ifs($RAILWAY_ENVIRONMENT, deployed, $CI, ci, eq($NODE_ENV, production), ci, development)

# off keeps a process on this machine's values alone.
# @sensitive=false @internal @type=enum(infisical, off)
ORBITDESK_SHARED_SECRETS=

# ------------------------------------------------------------
# Runtime wiring
# ------------------------------------------------------------

# The Docker image starts the worker for worker and the web app otherwise.
# @tag(web, worker) @sensitive=false @type=enum(web, worker)
APP_ROLE=

# @tag(web) @sensitive=false @type=port
PORT=

# @example="postgresql://orbitdesk:orbitdesk@localhost:55432/orbitdesk"
# @tag(web, worker, db) @required=forEnv(deployed) @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# Public web origin. Sets the OAuth redirect and the Secure cookie flag. The
# worker only names it to OpenRouter, so it keeps the local default there.
# @example="http://localhost:3100"
# @tag(web, worker) @sensitive=false @required=and(forEnv(deployed), not(eq($APP_ROLE, worker))) @type=url
APP_URL=

# ------------------------------------------------------------
# App secrets
# ------------------------------------------------------------

# Checked before a session is created. At least 32 characters.
# @tag(web) @required=forEnv(deployed) @type=string(minLength=32)
SESSION_SECRET=

# Encrypts Google credentials in Postgres. Base64 for exactly 32 bytes, as
# `openssl rand -base64 32` prints. Changing it locks out every connected account.
# @tag(web, worker) @required=forEnv(deployed) @type=string(matches=regex("^[A-Za-z0-9+/_-]{43}=?$"))
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------
# Google OAuth: both or neither. Without them the sandbox still works.
# ------------------------------------------------------------

# @tag(web, worker) @sensitive=false
GOOGLE_CLIENT_ID=

# @tag(web, worker)
GOOGLE_CLIENT_SECRET=

# Invited accounts, comma separated. Empty lets any Google account sign in. Not
# secret: leak protection would otherwise scrub a user's own address from responses.
# @tag(web) @sensitive=false
BETA_EMAILS=

# ------------------------------------------------------------
# Model. Without a key the agent is off and nothing is sent to a model.
# ------------------------------------------------------------

# @tag(web, worker)
# @proxy(domain="openrouter.ai", substituteIn=["header:authorization"])
OPENROUTER_API_KEY=

# A local stand-in for OpenRouter. Unset in every real environment.
# @tag(web, worker) @sensitive=false @type=url
OPENROUTER_BASE_URL=

# deny routes only to providers that do not retain or train on prompts.
# @tag(web, worker) @sensitive=false @type=enum(allow, deny)
OPENROUTER_DATA_COLLECTION=

# Quick classifications and yes/no decisions. Defaults to typesafe/jev-router.
# @tag(web, worker) @sensitive=false
AI_FAST_MODEL=

# Multi-step tool work. Defaults to z-ai/glm-5.3-flash.
# @tag(web, worker) @sensitive=false
AI_AGENT_MODEL=

# ------------------------------------------------------------
# Limits and schedules
# ------------------------------------------------------------
# Whole numbers only. The app reads these with Number(), and a value it cannot
# read would switch the limit off rather than fail.

# Only the word false turns the sandbox off, so nothing else is accepted.
# @tag(web, db) @sensitive=false @type=enum(true, false)
ENABLE_DEMO=

# @tag(web, worker) @sensitive=false @type=string(matches=regex("^[0-9]+$"))
MAX_AGENT_RUNS_PER_DAY=

# @tag(web, worker) @sensitive=false @type=string(matches=regex("^[0-9]+$"))
DEMO_RUNS_PER_DAY=

# @tag(web, worker) @sensitive=false @type=string(matches=regex("^[0-9]+$"))
MAX_TRIAGE_PER_DAY=

# @tag(web, worker) @sensitive=false @type=string(matches=regex("^[0-9]+$"))
MAX_AUTO_DRAFTS_PER_DAY=

# @tag(worker) @sensitive=false @type=string(matches=regex("^[0-9]+$"))
SYNC_INTERVAL_SECONDS=
