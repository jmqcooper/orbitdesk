# Read on development machines only. Docs: docs/SECRETS.md
#
# @defaultRequired=false
# @plugin(@varlock/infisical-plugin)
# @import(~/.config/varlock/.env.infisical, enabled=forEnv(development), allowMissing=true)
# @initInfisical(siteUrl=$INFISICAL_SITE_URL, projectId=$INFISICAL_PROJECT_ID, environment=$INFISICAL_ENVIRONMENT, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET)
# @setValuesBulk(infisicalBulk(), enabled=not(isEmpty($INFISICAL_CLIENT_ID)))
# ---

# @sensitive=false @internal @type=url
INFISICAL_SITE_URL=https://eu.infisical.com

# @sensitive=false @internal
INFISICAL_ENVIRONMENT=dev

# @sensitive=false @internal
INFISICAL_PROJECT_ID=76b72f55-2f1e-424e-aca6-5ac48c441ac1

# Comes from the machine's profile, ~/.config/varlock/.env.infisical.
# @type=infisicalClientId @internal
INFISICAL_CLIENT_ID=

# @type=infisicalClientSecret @sensitive @internal
INFISICAL_CLIENT_SECRET=
