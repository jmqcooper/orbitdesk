DATABASE_URL=postgresql://orbitdesk:orbitdesk@localhost:55432/orbitdesk
APP_URL=http://localhost:3100
SESSION_SECRET=replace-with-a-random-value-of-at-least-32-characters
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Every model call goes through OpenRouter. Without a key the agent is off and nothing is sent to a model.
OPENROUTER_API_KEY=
# Quick classifications and yes/no decisions (sorting mail into lanes).
AI_FAST_MODEL=typesafe/jev-router
# Multi-step work: drafting replies, the agent panel, briefs.
AI_AGENT_MODEL=z-ai/glm-5.3-flash
# Set to "deny" to route only to upstream providers that do not retain or train on prompts.
OPENROUTER_DATA_COLLECTION=
BETA_EMAILS=jmqcooper@gmail.com
ENABLE_DEMO=true
MAX_AGENT_RUNS_PER_DAY=100
DEMO_RUNS_PER_DAY=100
# Background work per real workspace per day: conversations sorted, replies drafted.
MAX_TRIAGE_PER_DAY=600
MAX_AUTO_DRAFTS_PER_DAY=50
SYNC_INTERVAL_SECONDS=120
PORT=3100
